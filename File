local function equipOrBuyTool()
    statusLabel.Text = "الحالة: 1️⃣ تجهيز أداة التهكير..."
    local char = LocalPlayer.Character
    local backpack = LocalPlayer:FindFirstChild("Backpack")

    local toolFound = false
    if backpack then
        for _, item in pairs(backpack:GetChildren()) do
            local n = item.Name:lower()
            if n:find("hack") or n:find("أداة") or n:find("جهاز") or n:find("card") or n:find("قفض") then
                item.Parent = char
                toolFound = true
                break
            end
        end
    end

    if not toolFound and char then
        for _, item in pairs(char:GetChildren()) do
            if item:IsA("Tool") then toolFound = true break end
        end
    end

    if not toolFound then
        for _, prompt in pairs(workspace:GetDescendants()) do
            if prompt:IsA("ProximityPrompt") then
                local act = prompt.ActionText:lower()
                local obj = prompt.ObjectText:lower()
                if act:find("شراء") or obj:find("متجر") or obj:find("أداة") or act:find("buy") then
                    local part = prompt.Parent:IsA("BasePart") and prompt.Parent or prompt.Parent:FindFirstChildWhichIsA("BasePart")
                    if part and char and char:FindFirstChild("HumanoidRootPart") then
                        char.HumanoidRootPart.CFrame = part.CFrame * CFrame.new(0, 0, 2)
                        task.wait(0.3)
                        fireproximityprompt(prompt)
                        task.wait(0.5)
                        break
                    end
                end
            end
        end
    end
end

