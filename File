
        if screenGui and not screenGui.IgnoreGuiInset then
            inset = GuiService:GetGuiInset()
        end
        local x, y = point.X + inset.X, point.Y + inset.Y
        logClick("physical", expectObj, x, y)
        if USE_TOUCH then
            VIM:SendTouchEvent(1, 0, x, y)
            task.wait(0.05)
            VIM:SendTouchEvent(1, 2, x, y)
        else
            VIM:SendMouseButtonEvent(x, y, 0, true, game, 0)
            task.wait(0.05)
            VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)

    return bestGui, barSet, preferred, floating
end

local lastClicked = setmetatable({}, { __mode = "k" })
local lastAnyClick = 0

local function clickCode(obj, gui)
    local btn = nil
    local cur = obj
    for _ = 1, 4 do
        if cur and isGuiButton(cur) then
            btn = cur
            break
        end
        cur = cur and cur.Parent
    end
    local since = tick() - lastAnyClick
    if since < 0.35 then task.wait(0.35 - since) end
    lastAnyClick = tick()

    if btn then pressButton(btn) end
    if (not btn) or ALWAYS_PHYSICAL then
        physicalClick(obj.AbsolutePosition + obj.AbsoluteSize / 2, gui, obj)
    end
end

local function solveCodes()
    local gui, barSet, preferred, floating = readCodes()
    if not gui then return false end

    local targets = {}
    if preferred then
        for _, e in ipairs(floating) do
            if e.tokens[1] == preferred then table.insert(targets, e) end
        end
        statusLabel.Text = "الحالة: 2️⃣ المطلوب: " .. preferred
    else
        for _, e in ipairs(floating) do
            if barSet[e.tokens[1]] then table.insert(targets, e) end
        end
        statusLabel.Text = "الحالة: 2️⃣ حل الأكواد..."
    end

    for _, e in ipairs(targets) do
        local last = lastClicked[e.obj]
        if not last or tick() - last > 1 then
            lastClicked[e.obj] = tick()
            clickCode(e.obj, gui)
            task.wait(0.12)
        end
    end
    return true
end

