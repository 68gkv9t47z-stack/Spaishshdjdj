local function isShown(obj)
    local cur = obj
    while cur and cur ~= game do
        if cur:IsA("GuiObject") and not cur.Visible then return false end
        if cur:IsA("ScreenGui") and not cur.Enabled then return false end
        cur = cur.Parent
    end
    return true
end

local function hasText(obj)
    return obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox")
end

local function isGuiButton(obj)
    return obj:IsA("TextButton") or obj:IsA("ImageButton")
end

local function getScreenGui(obj)
    return obj:FindFirstAncestorWhichIsA("ScreenGui")
end

local function isOurs(obj)
    return obj:IsDescendantOf(sg)
end

local function fullText(btn)
    local t = btn:IsA("TextButton") and btn.Text or ""
    for _, d in ipairs(btn:GetDescendants()) do
        if hasText(d) then t = t .. " " .. d.Text end
    end
    return t
end

-- سجل آخر الضغطات (للتشخيص)
local clickLog = {}
local function logClick(kind, obj, x, y)
    pcall(function()
        local name = "-"
        if obj then
            name = obj:GetFullName()
            if not x then
                local c = obj.AbsolutePosition + obj.AbsoluteSize / 2
                x, y = c.X, c.Y
            end
        end
        table.insert(clickLog, string.format("%.1f %s | %s | (%d,%d)",
            tick() % 10000, kind, name, math.floor(x or 0), math.floor(y or 0)))
        if #clickLog > 60 then table.remove(clickLog, 1) end
    end)
end

-- أزرار الشاشة الرئيسية اللي ما نبي نضغطها أبداً (سيارتك / المتجر / الهاتف ...)
local HUD_WORDS = { "سيارتك", "سيارات", "المتجر", "متجر", "الهاتف", "تذكرة", "season", "shop", "store", "phone" }

local function hudProtected(obj)
    local probe = { obj }
    if obj.Parent then table.insert(probe, obj.Parent) end
    for _, o in ipairs(probe) do
        if o:IsA("GuiObject") then
            local str = o.Name:lower()
            if hasText(o) then str = str .. " " .. o.Text:lower() end
            for _, c in ipairs(o:GetChildren()) do
                if hasText(c) then str = str .. " " .. c.Text:lower() end
            end
            for _, w in ipairs(HUD_WORDS) do
                if str:find(w, 1, true) then return true end
            end
        end
    end
    return false
end

local function pressButton(btn)
    if hudProtected(btn) then
        logClick("BLOCKED-HUD(signal)", btn)
        return
    end
    logClick("signal", btn)
    pcall(function() firesignal(btn.Activated) end)
    pcall(function() firesignal(btn.MouseButton1Click) end)
end

-- ضغطة فعلية: تتأكد أول إيش فوق المكان، وترفض إذا كان زر من الشاشة الرئيسية
local function physicalClick(point, screenGui, expectObj)
    pcall(function()
        local top = nil
        for _, o in ipairs(PlayerGui:GetGuiObjectsAtPosition(point.X, point.Y)) do
            if not isOurs(o) then
                top = o
                break
            end
        end
        if top and hudProtected(top) then
            logClick("BLOCKED-HUD(physical)", top, point.X, point.Y)
            return
        end
        if top and expectObj and getScreenGui(top) ~= getScreenGui(expectObj) then
            logClick("BLOCKED-covered(physical)", top, point.X, point.Y)
            return
        end

        local inset = Vector2.new(0, 0)
        if screenGui and not screenGui.IgnoreGuiInset then
            inset = GuiService:GetGuiInset()
        end
        local x, y = point.X + inset.X, point.Y + inset.Y
        logClick("physical", expectObj, x, y)
        if USE_TOUCH then
            VIM:SendTouchEvent(1, 0, x, y)
            task.wait(0.05)
            VIM:SendTouchEvent(1, 2, x, y)
        else
            VIM:SendMouseButtonEvent(x, y, 0, true, game, 0)
            task.wait(0.05)
            VIM:SendMouseButtonEvent(x, y, 0, false, game, 0)
        end
    end)
end

