-- بعد ما تفتح شاشة الصعوبة: اختيار خبير ثم حل الأكواد
-- ترجع: "played" | "cooldown" | false
local function playHack()
    local expertChosen = false
    local t0, lastClick, attempt = tick(), 0, 0
    while isRunning and tick() - t0 < 9 and not expertChosen do
        local gui, expertEl = findDifficultyScreen()
        if gui then
            statusLabel.Text = "الحالة: 2️⃣ اختيار مستوى خبير ⭐⭐⭐ (محاولة " .. (attempt + 1) .. ")"
            if tick() - lastClick > 1.5 then
                attempt = attempt + 1
                clickExpert(gui, expertEl, attempt)
                lastClick = tick()
            end
            task.wait(0.4)
            if not findDifficultyScreen() then expertChosen = true end
        else
            task.wait(0.1)
        end
    end
    if not expertChosen then return false end

    local t1, lastOpen = tick(), tick()
    local waitingSince, cooldownSince = nil, nil
    local sawCodes = false

    while isRunning and tick() - t1 < 90 do
        if findDifficultyScreen() then break end
        local found = solveCodes()
        if found then sawCodes = true end
        if found or hackUiOpen() then lastOpen = tick() end
        if tick() - lastOpen > 4 then break end

        if found then
            waitingSince, cooldownSince = nil, nil
        else
            waitingSince = waitingSince or tick()
            local secs = math.floor(tick() - waitingSince)

            if (not sawCodes) and cooldownVisible() then
                -- "تمهّل قليلاً" ومافيه أكواد = الصراف مو جاهز
                cooldownSince = cooldownSince or tick()
                local c = math.floor(tick() - cooldownSince)
                statusLabel.Text = "الحالة: ⏳ الصراف يقول تمهّل (" .. c .. "/" .. COOLDOWN_CONFIRM .. "ث)"
                if tick() - cooldownSince >= COOLDOWN_CONFIRM then
                    closeHackUi()
                    task.wait(0.5)
                    return "cooldown"
                end
            else
                cooldownSince = nil
                statusLabel.Text = "الحالة: بانتظار الأكواد (" .. secs .. "ث)"
            end

            if secs >= 30 then
                closeHackUi()
                break
            end
        end
        task.wait(0.15)
    end
    return "played"
end

local function hackATM()
    statusLabel.Text = "الحالة: 2️⃣ البحث عن صراف جاهز..."
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local list, cooling = availableATMs(hrp)
    local tries = 0

    for _, atm in ipairs(list) do
        if not isRunning or tries >= 5 then break end
        tries = tries + 1
        statusLabel.Text = "الحالة: 2️⃣ تجربة صراف رقم " .. tries .. "..."

        hrp.CFrame = atm.part.CFrame * CFrame.new(0, 0, 2)
        task.wait(0.5)
        pcall(function() fireproximityprompt(atm.prompt) end)

        -- إذا ما طلعت شاشة الصعوبة خلال 4 ثواني = الصراف مقفل
        local opened = false
        local t = tick()
        while isRunning and tick() - t < 4 do
            if findDifficultyScreen() then
                opened = true
                break
            end
            task.wait(0.1)
        end

        if opened then
            local res = playHack()
            if res == "cooldown" then
                -- فترة انتظار: نضاعف المدة كل مرة (60 ← 120 ← 240 ... حد أقصى 600)
                local lvl = atmCooldownLevel[atm.prompt] or 0
                atmCooldownLevel[atm.prompt] = lvl + 1
                atmCooldown[atm.prompt] = tick() + math.min(60 * (2 ^ lvl), 600)
                statusLabel.Text = "الحالة: ⏳ الصراف مو جاهز، أجرب اللي بعده"
            elseif res == "played" then
                atmCooldownLevel[atm.prompt] = 0
                atmBlacklist[atm.prompt] = tick() + 45
                return true
            else
                atmBlacklist[atm.prompt] = tick() + 40
            end
        else
            atmBlacklist[atm.prompt] = tick() + 40
            statusLabel.Text = "الحالة: الصراف مقفل ⛔ أجرب اللي بعده"
        end
    end

    if tries == 0 then
        if cooling > 0 then
            statusLabel.Text = "الحالة: كل الصرافات بفترة انتظار ⏳ أروح أغسل"
        else
            statusLabel.Text = "الحالة: ما لقيت أي صراف بالاسم"
            if not atmDumped then
                atmDumped = true
                dumpAllPrompts(hrp)
                statusLabel.Text = statusLabel.Text .. "\n📋 تم نسخ القائمة، الصقها في المحادثة"
            end
        end
        task.wait(1)
    end
    return false
end

-- ====================================================================
-- 4. غسيل الأموال
-- ====================================================================
local WASH_WORDS = { "غسيل", "غسل", "wash", "launder" }
local CONFIRM_WORDS = { "تأكيد", "confirm", "موافق" }

local function textHas(s, words)
    s = tostring(s or ""):lower()
    for _, w in ipairs(words) do
        if s:find(w, 1, true) then return true end
    end
    return false
end

local function partOfPrompt(prompt)
    local p = prompt.Parent
    if not p then return nil end
    if p:IsA("BasePart") then return p end
    if p:IsA("Attachment") and p.Parent and p.Parent:IsA("BasePart") then return p.Parent end
    return p:FindFirstChildWhichIsA("BasePart", true)
end

-- مكان شراء الأداة (نفس المكان اللي فيه الغسيل)
local shopPart = nil
local function findShop()
    if shopPart and shopPart.Parent then return shopPart end
    for _, prompt in ipairs(workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            local act = prompt.ActionText:lower()
            local obj = prompt.ObjectText:lower()
            if act:find("شراء") or obj:find("متجر") or obj:find("أداة") or act:find("buy") then
                local part = partOfPrompt(prompt)
                if part then
                    shopPart = part
                    return part
                end
            end
        end
    end
    return nil
end

local function nearbyPrompts(hrp, radius)
    local list = {}
    for _, prompt in ipairs(workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            local part = partOfPrompt(prompt)
            if part and (part.Position - hrp.Position).Magnitude <= radius then
                table.insert(list, prompt)
            end
        end
    end
    return list
end

local function promptIsWash(prompt)
    local p = prompt.Parent
    return textHas(prompt.ActionText, WASH_WORDS)
        or textHas(prompt.ObjectText, WASH_WORDS)
        or textHas(prompt.Name, WASH_WORDS)
        or (p ~= nil and textHas(p.Name, WASH_WORDS))
end

local function buttonOf(obj)
    local cur = obj
    for _ = 1, 4 do
        if cur and isGuiButton(cur) then return cur end
        cur = cur and cur.Parent
    end
    return nil
end

-- عناصر الغسيل/التأكيد الظاهرة (الأزرار أولاً، وإذا ما فيه أزرار نستخدم النصوص)
local function washGuiTargets()
    local washGuis = {}
    for _, d in ipairs(PlayerGui:GetDescendants()) do
        if hasText(d) and not isOurs(d) and isShown(d) and textHas(d.Text, WASH_WORDS) then
            local g = getScreenGui(d)
            if g then washGuis[g] = true end
        end
    end
    local buttons, labels = {}, {}
    for _, d in ipairs(PlayerGui:GetDescendants()) do
        if hasText(d) and not isOurs(d) and isShown(d) then
            local g = getScreenGui(d)
            if g and washGuis[g] and (textHas(d.Text, WASH_WORDS) or textHas(d.Text, CONFIRM_WORDS)) then
                if buttonOf(d) then table.insert(buttons, d) else table.insert(labels, d) end
            end
        end
    end
    if #buttons > 0 then return buttons end
    return labels
end

local washDumped = false
local function dumpWashDebug(hrp)
    local lines = { "== PROMPTS near player ==" }
    for _, prompt in ipairs(nearbyPrompts(hrp, 60)) do
        local part = partOfPrompt(prompt)
        table.insert(lines, string.format("%s | Action=\"%s\" Object=\"%s\" Enabled=%s Dist=%d MaxDist=%d",
            prompt:GetFullName(), prompt.ActionText, prompt.ObjectText, tostring(prompt.Enabled),
            math.floor((part.Position - hrp.Position).Magnitude), math.floor(prompt.MaxActivationDistance)))
    end
    table.insert(lines, "== VISIBLE TEXT ==")
    for _, d in ipairs(PlayerGui:GetDescendants()) do
        if hasText(d) and not isOurs(d) and isShown(d) and d.Text ~= "" then
            table.insert(lines, string.format("%s | %s | \"%s\"", d.ClassName, d:GetFullName(), d.Text))
            if #lines > 500 then break end
        end
    end
    pcall(function() setclipboard(table.concat(lines, "\n")) end)
end

local function washMoney()
    statusLabel.Text = "الحالة: 3️⃣ الذهاب لمكان الغسيل..."
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    local shop = findShop()
    if not shop then
        statusLabel.Text = "الحالة: ما لقيت مكان شراء الأداة"
        task.wait(2)
        return
    end

    hrp.CFrame = shop.CFrame * CFrame.new(0, 0, 3)
    task.wait(0.8)

    local didSomething = false
    local lastAct = tick()
    local t0 = tick()

    while isRunning and tick() - t0 < 12 do
        local acted = false

        -- 1) خيار غسيل على شكل ProximityPrompt
        for _, prompt in ipairs(nearbyPrompts(hrp, 40)) do
            if prompt.Enabled and promptIsWash(prompt) then
                local last = lastClicked[prompt]
                if not last or tick() - last > 2 then
                    lastClicked[prompt] = tick()
                    statusLabel.Text = "الحالة: 3️⃣ غسيل الأموال..."
                    pcall(function() fireproximityprompt(prompt) end)
                    acted = true
                    task.wait(0.5)
                end
            end
        end

        -- 2) خيار غسيل/تأكيد على شكل واجهة
        for _, d in ipairs(washGuiTargets()) do
            local last = lastClicked[d]
            if not last or tick() - last > 1.5 then
                lastClicked[d] = tick()
                statusLabel.Text = "الحالة: 3️⃣ غسيل الأموال (واجهة)..."
                clickCode(d, getScreenGui(d))
                acted = true
                task.wait(0.3)
            end
        end

        if acted then
            didSomething = true
            lastAct = tick()
        end
        if didSomething and tick() - lastAct > 2.5 then break end
        if not didSomething and tick() - t0 > 5 then break end
        task.wait(0.3)
    end

    if not didSomething then
        statusLabel.Text = "الحالة: ما لقيت خيار الغسيل عند المتجر"
        if not washDumped then
            washDumped = true
            dumpWashDebug(hrp)
            statusLabel.Text = statusLabel.Text .. "\n📋 تم نسخ التفاصيل، الصقها في المحادثة"
        end
        task.wait(2)
    else
        statusLabel.Text = "الحالة: ✅ تم الغسيل، إعادة الدورة..."
        task.wait(1)
    end
end

