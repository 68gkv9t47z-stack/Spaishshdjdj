-- حركة كل 5 دقايق: تمشي الشخصية شوي وتنقر ثم نكمل
local AFK_INTERVAL = 300
local lastAfk = tick()

local function afkAction()
    statusLabel.Text = "الحالة: 🚶 حركة مضادة للـ AFK..."
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not (hum and hrp) then return end

    local origin = hrp.Position

    -- نمشي لقدام شوي
    local ahead = origin + hrp.CFrame.LookVector * 8
    hum:MoveTo(ahead)
    local t = tick()
    while tick() - t < 2.5 and (hrp.Position - ahead).Magnitude > 2 do
        task.wait(0.1)
    end

    -- ننقر في مكان فاضي من الواجهات (عشان ما نضغط أي زر)
    pcall(function()
        local vp = workspace.CurrentCamera.ViewportSize
        local spot = nil
        for _, fx in ipairs({ 0.5, 0.3, 0.7, 0.4, 0.6 }) do
            for _, fy in ipairs({ 0.5, 0.4, 0.6, 0.35 }) do
                local px, py = vp.X * fx, vp.Y * fy
                if #PlayerGui:GetGuiObjectsAtPosition(px, py) == 0 then
                    spot = Vector2.new(px, py)
                    break
                end
            end
            if spot then break end
        end
        if spot then
            VirtualUser:CaptureController()
            VirtualUser:ClickButton1(spot)
            logClick("afk-click", nil, spot.X, spot.Y)
        end
    end)
    task.wait(0.3)

    -- نرجع لمكاننا
    hum:MoveTo(origin)
    t = tick()
    while tick() - t < 2.5 and (hrp.Position - origin).Magnitude > 2 do
        task.wait(0.1)
    end
end

local function afkIfDue()
    if tick() - lastAfk >= AFK_INTERVAL then
        lastAfk = tick()
        pcall(afkAction)
    end
end

-- أقرب وقت (بالثواني) يخلص فيه انتظار صراف
local function nextCooldownEta()
    local best = nil
    for _, t in pairs(atmCooldown) do
        local left = t - tick()
        if left > 0 and (not best or left < best) then best = left end
    end
    return best and math.ceil(best) or nil
end

