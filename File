local atmBlacklist = setmetatable({}, { __mode = "k" })
local atmCooldown = setmetatable({}, { __mode = "k" })      -- الصراف في فترة انتظار لين وقت معين
local atmCooldownLevel = setmetatable({}, { __mode = "k" }) -- كم مرة تكررت (للمضاعفة)
local COOLDOWN_CONFIRM = 8   -- كم ثانية نشوف "تمهّل" قبل ما نحكم إن الصراف مو جاهز

local function atmPartOf(prompt)
    local p = prompt.Parent
    if not p then return nil end
    if p:IsA("BasePart") then return p end
    if p:IsA("Attachment") and p.Parent and p.Parent:IsA("BasePart") then return p.Parent end
    return p:FindFirstChildWhichIsA("BasePart", true)
end

local LOCKED_WORDS = { "مقفل", "مغلق", "locked", "closed", "cooldown" }

local function promptLooksLocked(prompt)
    local s = (prompt.ActionText .. " " .. prompt.ObjectText):lower()
    for _, w in ipairs(LOCKED_WORDS) do
        if s:find(w, 1, true) then return true end
    end
    return false
end

-- كل الصرافات: اللي شكلها مفتوحة أولاً (الأقرب أولاً)، وبعدها الباقي كخيار احتياطي
local function availableATMs(hrp)
    local fresh, stale = {}, {}
    local cooling = 0
    for _, prompt in ipairs(workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            local pName = prompt.Parent and prompt.Parent.Name:lower() or ""
            local oText = prompt.ObjectText:lower()
            local aText = prompt.ActionText:lower()
            if pName:find("atm") or oText:find("صراف") or oText:find("atm") or aText:find("اختراق") then
                local cd = atmCooldown[prompt]
                local part = nil
                if cd and tick() < cd then
                    cooling = cooling + 1
                else
                    part = atmPartOf(prompt)
                end
                if part then
                    local expires = atmBlacklist[prompt]
                    local entry = {
                        prompt = prompt,
                        part = part,
                        dist = (part.Position - hrp.Position).Magnitude,
                        expires = expires or 0,
                    }
                    local looksOk = prompt.Enabled and not promptLooksLocked(prompt)
                    local resting = expires and tick() < expires
                    if looksOk and not resting then
                        table.insert(fresh, entry)
                    else
                        table.insert(stale, entry)
                    end
                end
            end
        end
    end
    table.sort(fresh, function(a, b) return a.dist < b.dist end)
    table.sort(stale, function(a, b)
        if a.expires ~= b.expires then return a.expires < b.expires end
        return a.dist < b.dist
    end)
    for _, e in ipairs(stale) do table.insert(fresh, e) end
    return fresh, cooling
end

local atmDumped = false
local function dumpAllPrompts(hrp)
    local rows = {}
    for _, prompt in ipairs(workspace:GetDescendants()) do
        if prompt:IsA("ProximityPrompt") then
            local part = atmPartOf(prompt)
            local d = part and (part.Position - hrp.Position).Magnitude or 99999
            table.insert(rows, {
                d = d,
                text = string.format("%s | Action=\"%s\" Object=\"%s\" Enabled=%s Dist=%d",
                    prompt:GetFullName(), prompt.ActionText, prompt.ObjectText,
                    tostring(prompt.Enabled), math.floor(d)),
            })
        end
    end
    table.sort(rows, function(a, b) return a.d < b.d end)
    local lines = {}
    for i = 1, math.min(#rows, 120) do table.insert(lines, rows[i].text) end
    pcall(function() setclipboard(table.concat(lines, "\n")) end)
end

