local function findDifficultyScreen()
    local screenGui, expertEl
    for _, d in ipairs(PlayerGui:GetDescendants()) do
        if hasText(d) and not isOurs(d) and isShown(d) then
            local txt = d.Text
            if txt:find("مستوى الصعوبة") then
                screenGui = getScreenGui(d)
            elseif txt:find("خبير") or txt:lower():find("expert") then
                expertEl = d
            end
        end
    end
    if screenGui and expertEl then return screenGui, expertEl end
    return nil, nil
end

