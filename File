local function findDifficultyScreen()
    local screenGui, expertEl
    for _, d in ipairs(PlayerGui:GetDescendants()) do
        if hasText(d) and not isOurs(d) and isShown(d) then
            local txt = d.Text
            if txt:find("مستوى الصعوبة") then
                screenGui = getScreenGui(d)
            elseif txt:find("خبير") or txt:lower():find("expert") then
                expertEl = d
            end
        end
    end
    if screenGui and expertEl then return screenGui, expertEl end
    return nil, nil
end

local BAD_DIFF = { "سهل", "متمرس", "easy", "medium" }

local function findButtonAt(screenGui, point)
    local best, bestArea
    for _, b in ipairs(screenGui:GetDescendants()) do
        if isGuiButton(b) and isShown(b) and not isOurs(b) then
            local p, s = b.AbsolutePosition, b.AbsoluteSize
            if point.X >= p.X and point.X <= p.X + s.X and point.Y >= p.Y and point.Y <= p.Y + s.Y then
                local low = fullText(b):lower()
                local bad = false
                for _, w in ipairs(BAD_DIFF) do
                    if low:find(w) then bad = true break end
                end
                if not bad and not hudProtected(b) then
                    local area = s.X * s.Y
                    if not bestArea or area < bestArea then best, bestArea = b, area end
                end
            end
        end
    end
    return best
end

-- محاولات متدرجة: إشارة الزر أولاً، والضغطة الفعلية آخر حل (وبحماية)
-- إشارة وحدة فقط (مو الثنتين مع بعض، لأن اللعبة تقول "تمهّل" إذا انطلقت أحداث كثيرة)
local function fireOne(btn, which)
    if hudProtected(btn) then
        logClick("BLOCKED-HUD(signal)", btn)
        return
    end
    logClick("signal-" .. which, btn)
    pcall(function() firesignal(btn[which]) end)
end

-- نفس ترتيب v4 اللي اشتغل: ضغطة فعلية وحدة أول، وبعدها إشارة وحدة بكل محاولة
local function clickExpert(screenGui, expertEl, attempt)
    local center = expertEl.AbsolutePosition + expertEl.AbsoluteSize / 2
    local btn = findButtonAt(screenGui, center)
    if attempt == 1 or attempt >= 4 or not btn then
        physicalClick(center, screenGui, btn or expertEl)
    elseif attempt == 2 then
        fireOne(btn, "MouseButton1Click")
    else
        fireOne(btn, "Activated")
    end
end

-- ====================================================================
-- قراءة الأكواد: الشريط السفلي (المطلوب) + الأكواد الطايرة
-- ====================================================================
local function isCode(tok)
    return #tok >= 3 and #tok <= 8
        and tok:match("^[A-Za-z0-9]+$") ~= nil
        and tok:match("%a") ~= nil
end

local function readCodes()
    local perGui = {}
    for _, d in ipairs(PlayerGui:GetDescendants()) do
        if hasText(d) and not isOurs(d) and isShown(d) then
            local txt = d.Text:gsub("<[^>]+>", ""):gsub("^%s+", ""):gsub("%s+$", "")
            if txt ~= "" then
                local tokens, words = {}, 0
                for tok in txt:gmatch("%S+") do
                    words = words + 1
                    if isCode(tok) then table.insert(tokens, tok) end
                end
                if #tokens > 0 and #tokens == words then
                    local gui = getScreenGui(d)
                    if gui then
                        perGui[gui] = perGui[gui] or {}
                        table.insert(perGui[gui], {
                            obj = d,
                            tokens = tokens,
                            cy = d.AbsolutePosition.Y + d.AbsoluteSize.Y / 2,
                            ts = d.TextSize,
                            tr = d.TextTransparency,
                        })
                    end
                end
            end
        end
    end

    local bestGui, bestList
    for g, list in pairs(perGui) do
        if not bestList or #list > #bestList then bestGui, bestList = g, list end
    end
    if not bestList or #bestList < 2 then return nil end

    local bar, floating = {}, {}
    local hasMulti = false
    for _, e in ipairs(bestList) do
        if #e.tokens >= 2 then hasMulti = true end
    end

    if hasMulti then
        for _, e in ipairs(bestList) do
            if #e.tokens >= 2 then table.insert(bar, e) else table.insert(floating, e) end
        end
    else
        -- الشريط = الصف الأدنى في الشاشة
        local maxCY = -math.huge
        for _, e in ipairs(bestList) do
            if e.cy > maxCY then maxCY = e.cy end
        end
        for _, e in ipairs(bestList) do
            if e.cy >= maxCY - 40 then table.insert(bar, e) else table.insert(floating, e) end
        end
    end
    if #bar == 0 or #floating == 0 then return nil end

    local barSet = {}
    for _, e in ipairs(bar) do
        for _, t in ipairs(e.tokens) do barSet[t] = true end
    end

    -- الكود المطلوب = الأكبر حجماً في الشريط، أو الأوضح (أقل شفافية)
    local preferred
    if #bar >= 2 and not hasMulti then
        local maxTS, cnt, cand = -1, 0, nil
        for _, e in ipairs(bar) do
            if e.ts > maxTS then maxTS, cnt, cand = e.ts, 1, e
            elseif e.ts == maxTS then cnt = cnt + 1 end
        end
        if cnt == 1 then
            preferred = cand.tokens[1]
        else
            local minTr, cnt2, cand2 = 2, 0, nil
            for _, e in ipairs(bar) do
                if e.tr < minTr then minTr, cnt2, cand2 = e.tr, 1, e
                elseif e.tr == minTr then cnt2 = cnt2 + 1 end
            end
            if cnt2 == 1 then preferred = cand2.tokens[1] end
        end
    end

    return bestGui, barSet, preferred, floating
end

local lastClicked = setmetatable({}, { __mode = "k" })
local lastAnyClick = 0

local function clickCode(obj, gui)
    local btn = nil
    local cur = obj
    for _ = 1, 4 do
        if cur and isGuiButton(cur) then
            btn = cur
            break
        end
        cur = cur and cur.Parent
    end
    local since = tick() - lastAnyClick
    if since < 0.35 then task.wait(0.35 - since) end
    lastAnyClick = tick()

    if btn then pressButton(btn) end
    if (not btn) or ALWAYS_PHYSICAL then
        physicalClick(obj.AbsolutePosition + obj.AbsoluteSize / 2, gui, obj)
    end
end

local function solveCodes()
    local gui, barSet, preferred, floating = readCodes()
    if not gui then return false end

    local targets = {}
    if preferred then
        for _, e in ipairs(floating) do
            if e.tokens[1] == preferred then table.insert(targets, e) end
        end
        statusLabel.Text = "الحالة: 2️⃣ المطلوب: " .. preferred
    else
        for _, e in ipairs(floating) do
            if barSet[e.tokens[1]] then table.insert(targets, e) end
        end
        statusLabel.Text = "الحالة: 2️⃣ حل الأكواد..."
    end

    for _, e in ipairs(targets) do
        local last = lastClicked[e.obj]
        if not last or tick() - last > 1 then
            lastClicked[e.obj] = tick()
            clickCode(e.obj, gui)
            task.wait(0.12)
        end
    end
    return true
end

