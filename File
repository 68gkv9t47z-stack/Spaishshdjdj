                    if isRunning then washMoney() end
                else
                    -- ما انهكر أي صراف → ما نغسل، ننتظر لين تفتح وحدة
                    local t = tick()
                    while isRunning and tick() - t < 6 do
                        local eta = nextCooldownEta()
                        statusLabel.Text = "الحالة: ⏳ ما فيه صراف جاهز، أنتظر"
                            .. (eta and ("\nأقرب صراف بعد ~" .. eta .. "ث") or "")
                        afkIfDue()
                        task.wait(1)
                    end
                end
                task.wait(0.5)
            end)
        end
    end
end)
